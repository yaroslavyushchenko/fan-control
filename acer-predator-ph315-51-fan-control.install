post_install() {
	echo '==> Enable the daemon:  systemctl enable --now fanctld.service'
	echo '==> fanctld only accepts local connections from UID/GID 1000 by default.'
	echo '    If that is not your UID, run "systemctl edit fanctld.service" and'
	echo '    set Environment=FANCTLD_UID=... / FANCTLD_GID=... before starting it.'
}

post_upgrade() {
	post_install
}
