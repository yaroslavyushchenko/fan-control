#!/usr/bin/env python3
"""Unprivileged client for fanctld. Talks to the daemon over its Unix
socket; no root or sudo required for the calling user."""

import json
import socket
import sys

SOCK_PATH = "/run/fanctld.sock"
COMMANDS = ("status", "full", "auto")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd not in COMMANDS:
        print(f"usage: {sys.argv[0]} [{'|'.join(COMMANDS)}]", file=sys.stderr)
        return 1

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(SOCK_PATH)
            s.sendall((cmd + "\n").encode())
            resp = s.recv(4096).decode()
    except (FileNotFoundError, ConnectionRefusedError):
        print(f"fanctld is not running (no socket at {SOCK_PATH})", file=sys.stderr)
        return 1
    except PermissionError:
        print(f"permission denied connecting to {SOCK_PATH}", file=sys.stderr)
        return 1

    print(resp.strip())
    return 0 if json.loads(resp).get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
