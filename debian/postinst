#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} fanctl.conf
fi

#DEBHELPER#

if [ "$1" = "configure" ] && [ -z "$2" ]; then
	echo "fan-control: add yourself to the fanctl group to use fanctl:"
	echo "    sudo usermod -aG fanctl \$USER   (then log out and back in)"
fi

exit 0
